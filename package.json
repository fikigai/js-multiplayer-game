{
  "name": "js-multiplayer-game",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k \"npm --workspace=server run dev\" \"npm --workspace=client run dev\"",
    "build": "npm --workspace=client run build",
    "start": "npm --workspace=server start",
    "format": "biome check --write .",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^9.1.0"
  }
}
